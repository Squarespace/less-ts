{
  "name": "@squarespace/less-ts-cli",
  "author": "Patrick Hensley <pathensley@gmail.com>",
  "license": "Apache-2.0",
  "main": "lib/lessc.js",
  "types": "lib/lessc.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/squarespace/less-ts"
  },
  "bin": {
    "slessc": "./bin/lessc.js"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "build:watch": "tsc -p ./tsconfig.build.json -w --preserveWatchOutput",
    "clean": "rimraf ./coverage ./lib && jest --clearCache",
    "clean:full": "rimraf ./node_modules",
    "generate": "ts-node scripts/generate.ts",
    "lint": "eslint src __tests__ bin",
    "reformat": "prettier --write bin src",
    "release": "",
    "stress": "echo 'fixme'",
    "test": "rimraf ./coverage && jest --coverage --verbose -i --no-cache --coverageReporters=html",
    "test:codecov": "rimraf ./coverage && jest --coverage --coverageReporters=lcovonly --verbose -i --no-cache",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@squarespace/less-ts": "^2.0.0",
    "@types/yargs": "^17.0.24",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.4",
    "@types/lodash": "4.14.198",
    "@types/node": "20.6.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "glob": "^10.3.4",
    "jest": "^29.6.4",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "rollup": "^3.29.1",
    "rollup-plugin-typescript2": "^0.35.0",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.1",
    "tslint": "5.20.1",
    "tslint-no-circular-imports": "^0.7.0",
    "typescript": "5.2.x"
  },
  "files": [
    "bin",
    "lib"
  ],
  "version": "2.0.0"
}
